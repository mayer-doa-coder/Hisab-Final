<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- Lint says the -v26 is unnecessary because minSdk is 26, and suggests
         mipmap-anydpi instead. Tried at Step 20: with AGP 9.4, a clean build then
         fails with "resource mipmap/ic_launcher not found" — the renamed folder
         never reaches the merged resources. So the working name stays. -->
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>

    <!-- The dashes lint wants replaced are inside literal ISO dates shown as
         examples ("2026-10-15"). An en dash there would be a different string
         and would stop the example matching what the field accepts. -->
    <issue id="TypographyDashes">
        <ignore path="src/main/res/values/strings.xml" />
        <ignore path="src/main/res/values-en/strings.xml" />
    </issue>
</lint>
